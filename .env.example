# Copy to .env (git-ignored) and fill in. Never commit real values.
# --- required ---------------------------------------------------------------
# Postgres password for this stack's own database — choose a long random value.
SELENNE_AGENTS_DB_PASSWORD=

# Selenne's internal key-verification endpoint (see README "Key verification").
# Selenne must accept connections from the Docker bridge for this to work.
SELENNE_VERIFY_URL=http://host.docker.internal:5000/internal/keys/verify
# Same value as SELENNE_INTERNAL_SECRET in Selenne's backend env.
SELENNE_INTERNAL_SECRET=
# Selenne's session probe, used by the console to recognise signed-in users.
SELENNE_ME_URL=http://host.docker.internal:5000/api/auth/me

# Where browsers reach Selenne (◈SELENNE → landing, sign-in, profile).
# Leave empty behind the shared nginx (same origin); set it when opening the
# console on its own port, e.g. http://127.0.0.1:5000
SELENNE_PUBLIC_URL=

# --- local / demo only ------------------------------------------------------
# Run the console WITHOUT Selenne: every visitor is signed in as this user.
# Local development only — never set in production.
SELENNE_AGENTS_DEV_USER=
# Fixed keys that skip Selenne entirely: key=username:project, comma-separated.
# Leave empty in production.
SELENNE_AGENTS_DEV_KEYS=

# --- tuning (defaults shown) ------------------------------------------------
# INGEST_KEY_CACHE_TTL=60            # seconds until a revoked key stops working
# INGEST_KEY_NEGATIVE_TTL=10
# INGEST_RATE_PER_SEC=20             # per key
# INGEST_RATE_BURST=40
# INGEST_MAX_BODY_BYTES=5242880      # 5 MB on the wire
# INGEST_MAX_DECOMPRESSED_BYTES=20971520
# INGEST_HTTP_PORT=4318
# INGEST_GRPC_PORT=4317
# CONSOLE_PORT=4319
# CONSOLE_SESSION_CACHE_TTL=30        # seconds until a SIEM sign-out reaches /agents/
